# Copy to .env and replace placeholders. Never commit .env.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRE_MINUTES=1440
AUTH_EXPOSE_VERIFICATION_CODE=true
GATEWAY_TIMEOUT_SECONDS=10
GATEWAY_PORT=8000

AUTH_DB_PASSWORD=replaceAuthDbPassword123
PRODUCT_DB_PASSWORD=replaceProductDbPassword123
ORDER_DB_PASSWORD=replaceOrderDbPassword123
PAYMENT_DB_PASSWORD=replacePaymentDbPassword123
CART_DB_PASSWORD=replaceCartDbPassword123

# Use Razorpay TEST credentials only.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret
